# バックエンド環境変数サンプル
# .env ファイルとしてコピーして使用してください

# データベース (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pupils_status

# JWT認証
SECRET_KEY=change-me-to-a-random-32-byte-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (フロントエンドURL)
FRONTEND_URL=http://localhost:5173

# Claude API (任意 — 設定するとリアルAI有効化)
# ANTHROPIC_API_KEY=sk-ant-api...
